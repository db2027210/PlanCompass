      "resource_types": [
        "memory",
        "cpu",
        "io"
      ],
      "shared": {
        "calibration_factor": 1.0,
        "explain_workers": 8,
        "block_size": 8192,
        "work_mem_bytes": 33554432,
        "hash_mem_multiplier": 1.0
      },
      "memory": {
        "enabled": true,
        "overlap_factor": 0.6,
        "concurrency_formula": "baseline_resident_plus_weighted_working",
        "resident_memory_scale": 1.0,
        "beta_sort": 1.0,
        "beta_hash": 1.0,
        "beta_hashagg": 1.0,
        "beta_materialize": 1.0,
        "beta_memoize": 0.0
