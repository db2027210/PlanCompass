{
  "capability": {
    "cpu": 24,
    "memory": 32,
    "io": 20
  },
  "optimizer": {
    "mode": "gradient",
    "gradient": {
      "eta": 2.0,
      "max_iter": 20,
      "patience": 3,
      "eta_growth_factor": 1.25,
      "eta_shrink_factor": 1.0,
      "initial_exploration_multiplier": 2.0,
      "max_eta": 50.0,
