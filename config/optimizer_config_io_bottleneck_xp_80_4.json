        "cpu_tuple_cost",
        "cpu_index_tuple_cost",
        "cpu_operator_cost",
        "parallel_setup_cost",
        "parallel_tuple_cost"
      ],
      "no_update_patience": 12
    },
    "bruteforce": {
      "max_iter": 3,
      "shrink_factor": 0.5,
      "early_stop_threshold": 2
