# Isolated MySQL worker used only by the gradient-descent experiments.
db=mysql
classname=com.mysql.jdbc.Driver
username=root
password=CHANGE_ME
url=jdbc:mysql://127.0.0.1:57751/hybench?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true

url_ap=jdbc:mysql://127.0.0.1:57751/hybench?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
classname_ap=com.mysql.jdbc.Driver
username_ap=root
password_ap=mysql

sf=1x
at1_percent=35
at2_percent=25
at3_percent=15
at4_percent=15
at5_percent=7
at6_percent=3

apclient=2
tpclient=16
risk_rate=0.1
fresh_interval=20
contention_num=100

apRunMins=1
tpRunMins=1
xpRunMins=1
xtpclient=16
xapclient=2

dist=uniform
power_alpha=0.1
apround=1
