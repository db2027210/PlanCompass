{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mysql_experience_table_t_v1.schema.json",
  "title": "Versioned MySQL formal experience table T",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "database", "scenario", "benchmark", "benchmark_version",
    "version", "workload_freeze_id", "workload_registry_sha256", "estimator",
    "parameter_space", "resource_columns", "table", "effect_evidence",
    "calibration", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "mysql_experience_table_t_v1"},
    "database": {"const": "mysql"},
    "scenario": {"type": "string", "minLength": 1},
    "benchmark": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "workload_freeze_id": {"type": "string", "minLength": 1},
    "workload_registry_sha256": {"$ref": "#/$defs/sha256"},
    "sql_registry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "estimator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "model_artifact_sha256": {
          "type": "object", "additionalProperties": false,
          "required": ["cpu", "memory", "io"],
          "properties": {
            "cpu": {"$ref": "#/$defs/sha256"},
            "memory": {"$ref": "#/$defs/sha256"},
            "io": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "parameter_space": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sha256", "active_params", "ranges"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "active_params": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ranges": {"type": "object", "minProperties": 1}
      }
    },
    "resource_columns": {"const": ["cpu", "memory", "io"]},
    "table": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/numericResourceEffects"}
    },
    "effect_evidence": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/resourceEffects"}
    },
    "calibration": {"type": "object"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["request_sha256", "evidence_class", "source", "real_measurement", "cross_engine_prior_used"],
      "properties": {
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_class": {
          "enum": [
            "mysql_complete_formal_two_sided_oat",
            "mysql_trained_estimator_complete_endpoint_features"
          ]
        },
        "source": {"enum": ["real_measurement", "trained_estimator_experience"]},
        "real_measurement": {"type": "boolean"},
        "cross_engine_prior_used": {"const": false},
        "point_artifacts": {"type": "array", "minItems": 1},
        "endpoint_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "endpoint_artifacts": {"type": "object", "minProperties": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "real_measurement"}}},
          "then": {
            "required": ["point_artifacts"],
            "properties": {
              "real_measurement": {"const": true},
              "evidence_class": {"const": "mysql_complete_formal_two_sided_oat"}
            }
          }
        },
        {
          "if": {"properties": {"source": {"const": "trained_estimator_experience"}}},
          "then": {
            "required": ["endpoint_evidence", "endpoint_artifacts"],
            "properties": {
              "real_measurement": {"const": false},
              "evidence_class": {"const": "mysql_trained_estimator_complete_endpoint_features"}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {"source": {"const": "trained_estimator_experience"}}
          }
        }
      },
      "then": {
        "required": ["sql_registry"],
        "properties": {
          "estimator": {"required": ["id", "version", "sha256", "model_artifact_sha256"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "signed_effect_full_range", "observed_median_effect_full_range", "magnitude_full_range", "confidence"],
      "properties": {
        "direction": {"enum": ["increase", "decrease", "neutral"]},
        "signed_effect_full_range": {"type": "number"},
        "observed_median_effect_full_range": {"type": "number"},
        "observed_delta": {"type": "number"},
        "tolerance": {"type": "number", "exclusiveMinimum": 0},
        "magnitude_full_range": {"type": "number", "minimum": 0},
        "evidence_status": {"enum": ["DETECTED_EFFECT", "NO_DETECTABLE_EFFECT"]},
        "parameter_effect_status": {"enum": ["DETECTED_EFFECT", "NO_DETECTABLE_EFFECT"]},
        "confidence": {"type": "object"}
      }
    },
    "resourceEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory", "io"],
      "properties": {
        "cpu": {"$ref": "#/$defs/effect"},
        "memory": {"$ref": "#/$defs/effect"},
        "io": {"$ref": "#/$defs/effect"}
      }
    },
    "numericResourceEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu", "memory", "io"],
      "properties": {
        "cpu": {"type": "number"},
        "memory": {"type": "number"},
        "io": {"type": "number"}
      }
    }
  }
}
