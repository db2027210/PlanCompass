  "outer": {
    "global_real_replay_top_k_hard_cap": 5,
    "applies_to_all_algorithms": true,
    "qps_source": "real paired replay only",
    "minimum_db_qps_improvement_pct": 15.0,
    "target_resource_must_strictly_decrease": true,
    "non_target_resource_must_not_become_bottleneck": true,
